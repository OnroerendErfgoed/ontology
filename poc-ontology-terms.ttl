# NOT FOR master.
#
# This file exists on the branch `poc-startup-gate` and nowhere else. It
# defines the terms the dossier platform's two demonstration processes
# name — `toelatingen` and `openbaarheid van bestuur` — so that the
# engine's startup gate can be satisfied without pretending those terms
# are part of the published Onroerend Erfgoed vocabulary. They are not.
# They are the vocabulary of a proof of concept, and several of them
# (`oe:testDienAanvraagInV2`, `oe:testBewerkAanvraagV2Only`) exist only
# to exercise workflow versioning.
#
# The engine refuses to start when a process names a term no vocabulary
# defines — deliberately, because a term nobody publishes is a term
# nobody can look up, and this platform keeps what it records for
# decades. Baselining them instead would have said "we tolerate these",
# which is weaker and gets forgotten; defining them here says what they
# are, where anyone can read it, while keeping them out of master.
#
# Every term is `unstable`: this is a proof of concept, and nothing here
# carries the append-only promise that master's terms carry.
#
# Generated from the two workflow definitions, so what a term *is* here
# is what the engine actually treats it as: an activity, an entity type,
# a relation type, or the functional role of an agent.

@prefix oe:    <https://id.erfgoed.net/vocab/ontology#>.
@prefix owl:   <http://www.w3.org/2002/07/owl#>.
@prefix prov:  <http://www.w3.org/ns/prov#>.
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#>.
@prefix vs:    <http://www.w3.org/2003/06/sw-vocab-status/ns#>.
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#>.

# The `oe:` namespace is claimed by ontology.ttl on master; this file
# only adds terms in it, and only on this branch.

### Terms the `toelatingen` demonstration process names

# Activities

oe:bewerkAanvraag a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "bewerkAanvraag"@nl-BE;
    vs:term_status "unstable".

oe:bewerkRelaties a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "bewerkRelaties"@nl-BE;
    vs:term_status "unstable".

oe:dienAanvraagIn a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "dienAanvraagIn"@nl-BE;
    vs:term_status "unstable".

oe:doeVoorstelBeslissing a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "doeVoorstelBeslissing"@nl-BE;
    vs:term_status "unstable".

oe:duidBehandelaarAan a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "duidBehandelaarAan"@nl-BE;
    vs:term_status "unstable".

oe:duidVerantwoordelijkeOrganisatieAan a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "duidVerantwoordelijkeOrganisatieAan"@nl-BE;
    vs:term_status "unstable".

oe:duidVerantwoordelijkenAan a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "duidVerantwoordelijkenAan"@nl-BE;
    vs:term_status "unstable".

oe:neemBeslissing a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "neemBeslissing"@nl-BE;
    vs:term_status "unstable".

oe:setDossierAccess a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "setDossierAccess"@nl-BE;
    vs:term_status "unstable".

oe:setSystemFields a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "setSystemFields"@nl-BE;
    vs:term_status "unstable".

oe:tekenBeslissing a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "tekenBeslissing"@nl-BE;
    vs:term_status "unstable".

oe:testBewerkAanvraagV2Only a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "testBewerkAanvraagV2Only"@nl-BE;
    vs:term_status "unstable".

oe:testDienAanvraagInV2 a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "testDienAanvraagInV2"@nl-BE;
    vs:term_status "unstable".

oe:trekAanvraagIn a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "trekAanvraagIn"@nl-BE;
    vs:term_status "unstable".

oe:vervolledigAanvraag a owl:Class;
    rdfs:subClassOf prov:Activity;
    rdfs:label "vervolledigAanvraag"@nl-BE;
    vs:term_status "unstable".

# Entity types

oe:aanvraag a owl:Class;
    rdfs:subClassOf prov:Entity;
    rdfs:label "aanvraag"@nl-BE;
    vs:term_status "unstable".

oe:behandelaar a owl:Class;
    rdfs:subClassOf prov:Entity;
    a prov:Role;
    rdfs:label "behandelaar"@nl-BE;
    vs:term_status "unstable".

oe:beslissing a owl:Class;
    rdfs:subClassOf prov:Entity;
    rdfs:label "beslissing"@nl-BE;
    vs:term_status "unstable".

oe:bijlagen a owl:Class;
    rdfs:subClassOf prov:Entity;
    rdfs:label "bijlagen"@nl-BE;
    vs:term_status "unstable".

oe:dossierVerantwoordelijken a owl:Class;
    rdfs:subClassOf prov:Entity;
    rdfs:label "dossierVerantwoordelijken"@nl-BE;
    vs:term_status "unstable".

oe:DigitaalDossier a owl:Class;
    rdfs:subClassOf oe:Dossier;
    rdfs:label "Digitaal dossier"@nl-BE;
    rdfs:label "Digital dossier"@en;
    rdfs:comment """Een dossier dat op dit platform behandeld wordt: de eenheid
    waarin entiteiten, activiteiten en relaties gegroepeerd zijn, en waarop
    schrijfbewerkingen geserialiseerd worden. Enger dan `oe:Dossier`, dat ook
    een papieren dossier dekt — en dat is precies waarom het bestaat: alleen in
    `from_types`/`to_types` van een relatie geldig, waar de engine moet kunnen
    nagaan dat een eindpunt een dossier van dit platform is. Het is géén
    `entity_types:`-waarde en mag er geen worden: een dossier heeft geen
    versies, geen inhoud en geen model."""@nl-BE;
    vs:term_status "unstable".

oe:Rechtsgrond a owl:Class;
    rdfs:subClassOf prov:Entity;
    rdfs:label "Rechtsgrond"@nl-BE;
    rdfs:comment """Het artikel of de regelgeving waar een beslissing onder valt,
    uitgegeven door de Vlaamse Codex. Een `external: true`-entiteitstype: de
    identiteit wordt elders gemunt en de engine bewaart alleen de URI."""@nl-BE;
    vs:term_status "unstable".

oe:handtekening a owl:Class;
    rdfs:subClassOf prov:Entity;
    rdfs:label "handtekening"@nl-BE;
    vs:term_status "unstable".

oe:system_fields a owl:Class;
    rdfs:subClassOf prov:Entity;
    rdfs:label "system_fields"@nl-BE;
    vs:term_status "unstable".

oe:verantwoordelijke_organisatie a owl:Class;
    rdfs:subClassOf prov:Entity;
    a prov:Role;
    rdfs:label "verantwoordelijke_organisatie"@nl-BE;
    vs:term_status "unstable".

# Relation types

oe:betreft a rdf:Property;
    rdfs:label "betreft"@nl-BE;
    vs:term_status "unstable".

oe:gerelateerd_aan a rdf:Property;
    rdfs:label "gerelateerd_aan"@nl-BE;
    vs:term_status "unstable".

oe:neemtAkteVan a rdf:Property;
    rdfs:label "neemtAkteVan"@nl-BE;
    vs:term_status "unstable".

oe:valtOnder a rdf:Property;
    rdfs:label "valtOnder"@nl-BE;
    vs:term_status "unstable".

# Roles
#
# The functional role of the agent — what they did in the activity, written
# into `prov:hadRole`. `oe:behandelaar` and `oe:verantwoordelijke_organisatie`
# are above, with the entity types, because the process uses each of those
# names for both a role and an entity type.

oe:aanvrager a prov:Role;
    rdfs:label "aanvrager"@nl-BE;
    rdfs:comment """Diende de aanvraag in, of handelde verder namens de
    aanvrager."""@nl-BE;
    vs:term_status "unstable".

oe:ondertekenaar a prov:Role;
    rdfs:label "ondertekenaar"@nl-BE;
    rdfs:comment """Tekende de beslissing."""@nl-BE;
    vs:term_status "unstable".


### The three attributes the PROV renderer mints

# Unlike everything above, these are **not** generated from a workflow
# definition and they are not proof-of-concept vocabulary. The engine's
# PROV-JSON builder writes them on every entity and every agent node of
# every document it produces, in `oe:`, whatever process the dossier
# belongs to. In PROV-JSON they are attributes; in the PROV-O
# serialisation they become predicates in our own published namespace,
# so each one is a URI in a record kept for decades that today resolves
# to nothing.
#
# They sit here because this branch is what the startup gate reads, and
# because `oe:` is claimed by master's ontology.ttl so nothing else on
# this branch may claim it. That makes this a temporary home and not the
# right one: these three belong in the published platform vocabulary,
# which is where they should move once it is willing to carry them.
#
# Nothing had ever asked whether they were defined. `declared_terms()`
# walks what a *definition* names — activities, entity types, relation
# types, roles — and these come from the renderer, so no traversal over
# definitions can reach them. Found 2026-10-29, defined 2026-11-13.

oe:entityId a owl:DatatypeProperty;
    rdfs:domain prov:Entity;
    rdfs:range xsd:string;
    rdfs:label "entityId"@en;
    rdfs:comment """The identifier of the logical entity this version is a
    snapshot of. Every version of one logical entity carries the same
    value; it is what makes a revision chain recognisable as being about
    one thing."""@en;
    vs:term_status "unstable".

oe:versionId a owl:DatatypeProperty;
    rdfs:domain prov:Entity;
    rdfs:range xsd:string;
    rdfs:label "versionId"@en;
    rdfs:comment """The identifier of this version itself, as opposed to the
    logical entity it belongs to. Distinct from the node's own IRI, which
    encodes the dossier and the type as well."""@en;
    vs:term_status "unstable".

oe:agentId a owl:DatatypeProperty;
    rdfs:domain prov:Agent;
    rdfs:range xsd:string;
    rdfs:label "agentId"@en;
    rdfs:comment """The platform's own identifier for this agent, carried
    beside the agent's IRI so a reader can correlate a node back to the
    persistence layer. Present only when the node is keyed on an IRI; when
    it is not, the key already is this identifier."""@en;
    vs:term_status "unstable".

oe:agentCode a owl:DatatypeProperty;
    rdfs:domain prov:Agent;
    rdfs:range xsd:string;
    rdfs:label "agentCode"@en;
    rdfs:comment """An administrative code identifying this agent in a
    register other than the one its IRI comes from — an OVO code for a
    Flemish public body, for example. Always accompanied by
    `oe:agentCodeScheme`: an OVO code and a KBO number look alike and
    identify different things."""@en;
    vs:term_status "unstable".

oe:agentCodeScheme a owl:DatatypeProperty;
    rdfs:domain prov:Agent;
    rdfs:range xsd:string;
    rdfs:label "agentCodeScheme"@en;
    rdfs:comment """Which register `oe:agentCode` is from. A code without
    its register is a number with no meaning."""@en;
    vs:term_status "unstable".
